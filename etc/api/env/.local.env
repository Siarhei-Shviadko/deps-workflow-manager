ENV=development

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_DB=workflow-manager
DATABASE_USER=deps-postgres
DATABASE_PASSWORD=deps-postgres-password
MASTER_CHANGELOG=./migrations/master.yaml
DATABASE_DIALECT=postgresql
DATABASE_DRIVER=psycopg2
DATABASE_REQUIRE_SECURE_TRANSPORT=false

# asb kafka rabbitmq
MESSAGING_DRIVER=rabbitmq
MESSAGE_BROKER_CONNECTION_STRING=amqp://deps-rabbitmq:deps-rabbitmq-password@localhost:5672/deps
RABBITMQ_TLS_DLX_PER_QUEUE=false

# Kafka
KAFKA_GROUP_ID=workflow-manager

# Auth
AUTH_VERIFY_SSL=false

LOG_LEVEL=INFO
DOCUMENTATION_ENABLED=true

FILE_STORAGE_URL=http://localhost:8003/api/storage/v1/file
FILE_STORAGE_EXTERNAL_URL=http://localhost:8000/api/storage/v1/file
DOCUMENT_TYPE_SERVICE_URL=http://localhost:8015
TEMPLATE_SERVICE_URL=http://localhost:8020
DOCUMENT_SERVICE_URL=http://localhost:8001
EXTRACTION_SERVICE_URL=http://localhost:8022

VERSION_CLASSIFICATION_ENABLED=false
