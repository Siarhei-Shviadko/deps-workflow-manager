ENV=testing

# Database
DATABASE_HOST=test-database
DATABASE_PORT=5432
DATABASE_DB=test_deps
DATABASE_USER=deps-postgres
DATABASE_PASSWORD=deps-postgres-password
MASTER_CHANGELOG=./migrations/master.yaml
TESTING=true
DATABASE_DIALECT=postgresql
DATABASE_DRIVER=psycopg2
DATABASE_REQUIRE_SECURE_TRANSPORT=false

# asb kafka rabbitmq
MESSAGING_DRIVER=rabbitmq
MESSAGE_BROKER_CONNECTION_STRING=amqp://deps-rabbitmq:deps-rabbitmq-password@test-rabbitmq:5672/test_deps

# Kafka
KAFKA_GROUP_ID=workflow-manager

AUTH_VERIFY_SSL=false

DOCUMENTATION_ENABLED=true

FILE_STORAGE_URL=http://deps-file-storage-nginx:8000/api/storage/v1/file
FILE_STORAGE_EXTERNAL_URL=http://localhost:8003/api/storage/v1/file
DOCUMENT_TYPE_SERVICE_URL=http://deps-document-type:8000
TEMPLATE_SERVICE_URL=http://deps-template:8000
DOCUMENT_SERVICE_URL=http://deps-document-api:8000
EXTRACTION_SERVICE_URL=http://deps-extraction:8000
