ENV=development

# Database
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_DB=workflow-manager
DATABASE_USER=deps-postgres
DATABASE_PASSWORD=deps-postgres-password
MASTER_CHANGELOG=./migrations/master.yaml
DATABASE_DIALECT=postgresql
DATABASE_DRIVER=psycopg2
DATABASE_REQUIRE_SECURE_TRANSPORT=false

# asb kafka rabbitmq
MESSAGING_DRIVER=rabbitmq
MESSAGE_BROKER_CONNECTION_STRING=amqp://deps-rabbitmq:deps-rabbitmq-password@deps-rabbitmq:5672/deps
RABBITMQ_TLS_DLX_PER_QUEUE=false

# Kafka
KAFKA_GROUP_ID=workflow-manager

# Auth
AUTH_VERIFY_SSL=false

LOG_LEVEL=INFO
DOCUMENTATION_ENABLED=true

FILE_STORAGE_URL=http://deps-file-storage-nginx:8000/api/storage/v1/file
FILE_STORAGE_EXTERNAL_URL=http://localhost:8000/api/storage/v1/file
DOCUMENT_TYPE_SERVICE_URL=http://deps-document-type:8000
TEMPLATE_SERVICE_URL=http://deps-template:8000
DOCUMENT_SERVICE_URL=http://deps-document-api:8000
EXTRACTION_SERVICE_URL=http://deps-extraction:8000

VERSION_CLASSIFICATION_ENABLED=false
CLASSIFICATION_ENABLED=false
VALIDATION_ENABLED=false

# Telemetry
INSTRUMENTATION_ENABLED=false
SERVICE_NAME=deps-workflow-manager
EXPORTER_TYPE=azure

# otlp example
OTLP_LOG_ENDPOINT=http://deps-otlp:4317
OTLP_TRACE_ENDPOINT=http://deps-otlp:4318/v1/traces
APPLICATION_INSIGHTS_CONNECTION_STRING=...
